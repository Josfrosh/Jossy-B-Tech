<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JossyB – Technical Resources & Growth</title>
  <style>
    :root {
      --navy-950: #070f22;
      --navy-900: #0b1e3d;
      --navy-800: #142850;
      --gold-500: #c9a227;
      --gold-400: #e0c15a;
      --cream-100: #f5f1e8;
      --ink-300: rgba(245, 241, 232, 0.66);
      --ink-500: rgba(245, 241, 232, 0.42);
      --line: rgba(245, 241, 232, 0.12);
      --radius: 14px;
      --font-display: 'Fraunces', serif;
      --font-body: 'Inter', sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: radial-gradient(1100px 500px at 85% -10%, rgba(201, 162, 39, 0.14), transparent 60%),
                  var(--navy-950);
      color: var(--cream-100);
      font-family: var(--font-body);
      line-height: 1.5;
    }
    a { color: inherit; text-decoration: none; }
    h1, h2 { font-family: var(--font-display); font-weight: 600; }
    
    /* Navigation */
    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 32px;
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      background: rgba(7, 15, 34, 0.85);
      backdrop-filter: blur(8px);
      z-index: 10;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: 0.02em;
    }
    .brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: linear-gradient(145deg, var(--gold-400), var(--gold-500));
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--navy-950);
      font-weight: 700;
      font-size: 0.9rem;
    }
    .nav-links {
      display: flex;
      gap: 26px;
      font-size: 0.92rem;
      color: var(--ink-300);
    }
    .nav-links a {
      transition: color 0.15s;
    }
    .nav-links a:hover {
      color: var(--gold-400);
    }
    .nav-cta {
      display: flex;
      gap: 12px;
    }
    .btn {
      padding: 10px 20px;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.15s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .btn-primary {
      background: linear-gradient(145deg, var(--gold-400), var(--gold-500));
      color: var(--navy-950);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
    }
    .btn-secondary {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--cream-100);
    }
    .btn-secondary:hover {
      border-color: var(--gold-400);
      color: var(--gold-400);
    }

    /* Hero */
    .hero {
      max-width: 1080px;
      margin: 0 auto;
      padding: 80px 32px;
      text-align: center;
    }
    .hero h1 {
      font-size: 3rem;
      margin-bottom: 20px;
      line-height: 1.1;
    }
    .hero .tagline {
      font-size: 1.1rem;
      color: var(--ink-300);
      margin-bottom: 40px;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero .cta-group {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero .cta-group .btn {
      padding: 14px 32px;
      font-size: 0.95rem;
    }

    /* Features */
    .features {
      max-width: 1080px;
      margin: 0 auto;
      padding: 60px 32px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 32px;
    }
    .feature-card {
      background: var(--navy-900);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 32px;
      text-align: center;
    }
    .feature-card .icon {
      font-size: 2.5rem;
      margin-bottom: 16px;
    }
    .feature-card h3 {
      font-size: 1.1rem;
      margin-bottom: 10px;
    }
    .feature-card p {
      color: var(--ink-300);
      font-size: 0.9rem;
    }

    footer {
      text-align: center;
      padding: 30px;
      color: var(--ink-500);
      font-size: 0.82rem;
      border-top: 1px solid var(--line);
    }

    @media (max-width: 640px) {
      nav { padding: 14px 18px; }
      .nav-links { display: none; }
      .hero { padding: 50px 18px; }
      .hero h1 { font-size: 2rem; }
      .features { padding: 40px 18px; gap: 20px; }
    }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

  <!-- Cookie-less tracking snippet (added) -->
  <script>
  (function(){
    var k = 'jb_v', v = localStorage.getItem(k);
    if (!v) { v = Math.random().toString(36).slice(2); localStorage.setItem(k, v); }
    var u = new URLSearchParams(location.search);
    fetch('https://jossybmarketingagent.lovable.app/api/public/track', {
      method: 'POST',
      keepalive: true,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        path: location.pathname,
        referrer: document.referrer,
        utm_source: u.get('utm_source') || '',
        visitor: v
      })
    }).catch(function(){});
  })();
  </script>

</head>
<body>

<nav>
  <a href="index.html" class="brand">
    <span class="brand-mark">JB</span>
    <span>JOSSYB</span>
  </a>
  <div class="nav-links">
    <a href="services.html">Services</a>
    <a href="pricing.html">Pricing</a>
    <a href="booking.html">Booking</a>
  </div>
  <div class="nav-cta">
    <a href="login.html" class="btn btn-secondary">Log in</a>
    <a href="register.html" class="btn btn-primary">Register</a>
  </div>
</nav>

<section class="hero">
  <h1>Unlock Your Potential</h1>
  <p class="tagline">Get production-ready AI automation, job opportunities, investment deals, and skills training—all in one place.</p>
  <div class="cta-group">
    <a href="register.html" class="btn btn-primary">Get Started Free</a>
    <a href="services.html" class="btn btn-secondary">Explore Services</a>
  </div>
</section>

<section class="features">
  <div class="feature-card">
    <div class="icon">📈</div>
    <h3>Business Growth</h3>
    <p>Production-ready AI solutions to automate and scale your business</p>
  </div>
  <div class="feature-card">
    <div class="icon">🔗</div>
    <h3>Job & Linkups</h3>
    <p>Access verified job opportunities and career connections</p>
  </div>
  <div class="feature-card">
    <div class="icon">📊</div>
    <h3>Investment</h3>
    <p>Discover vetted investment opportunities tailored to you</p>
  </div>
  <div class="feature-card">
    <div class="icon">🎓</div>
    <h3>Skill Acquisition</h3>
    <p>Learn new skills, get certified, and connect with job opportunities</p>
  </div>
</section>

<!-- Survey section (added) -->
<section style="display: flex; justify-content: center; padding: 40px 20px;">
  <form action="https://jossybmarketingagent.lovable.app/api/public/subscribe" method="POST" style="display:grid;gap:12px;width:100%;max-width:440px;background:#141c24;color:#f3f4f6;padding:24px;border-radius:12px;border:1px solid #2a3746;font-family:sans-serif">
    <strong style="font-size:1.1rem;color:#f2c94c">Which digital solution do you need most?</strong>
    <p style="font-size:0.85rem;color:#9ca3af;margin:0 0 8px">Tell us what you're working toward and receive our free guide.</p>
    
    <label style="display:flex;align-items:center;gap:8px;cursor:pointer"><input type="radio" name="need" value="Help getting a job"> Help getting a job</label>
    <label style="display:flex;align-items:center;gap:8px;cursor:pointer"><input type="radio" name="need" value="Learning a new skill to earn"> Learning a new skill to earn</label>
    <label style="display:flex;align-items:center;gap:8px;cursor:pointer"><input type="radio" name="need" value="Automating my business"> Automating my business</label>
    <label style="display:flex;align-items:center;gap:8px;cursor:pointer"><input type="radio" name="need" value="A website or app"> A website or app</label>
    
    <textarea name="note" rows="3" maxlength="1000" placeholder="Or tell us in your own words what you need..." style="padding:10px;border-radius:6px;border:1px solid #374151;background:#0b1118;color:#fff;resize:vertical"></textarea>
    
    <input type="hidden" name="list_id" value="8f10d8af-0519-4a47-9ab0-315d58c4a2a5">
    <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">
    
    <input type="text" name="first_name" placeholder="Your name" style="padding:10px;border-radius:6px;border:1px solid #374151;background:#0b1118;color:#fff">
    <input type="email" name="email" placeholder="Email address for guide delivery" required style="padding:10px;border-radius:6px;border:1px solid #374151;background:#0b1118;color:#fff">
    
    <button type="submit" style="padding:12px;background:#f2c94c;color:#111;border:0;border-radius:6px;font-weight:700;cursor:pointer">Send my answer</button>
  </form>
</section>

<footer>
  © 2025 JossyB Technical Resources Nigeria Limited. Empowering Growth Across the Globe.
</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="auth.js"></script>
<script>
  // Redirect logged-in users to dashboard
  (async () => {
    await redirectIfLoggedIn();
  })();
</script>
</body>
</html>
